; Requirements-first evaluation profile. This is not a product wire protocol.
; Integer keys are emitted in ascending order using deterministic CBOR.
mesh-eval-envelope-v0 = {
  0  => 0,                         ; profile version
  1  => bytes .size 32,            ; item identifier
  2  => 0..3,                      ; State, Event, Record, Blob
  3  => text .size (1..128),       ; topic
  4  => text .size (1..128),       ; scope
  5  => 0..3,                      ; provisional priority value
  6  => uint,                      ; TTL in seconds
  7  => bytes .size 32,            ; authenticated publisher identifier
  8  => [* bytes .size 32],        ; zero to 64 unique causal parents
  9  => { * uint => [bool, bytes] }, ; extension: critical flag and value
  10 => bytes .size (1..65536),    ; opaque source-protected object
}

